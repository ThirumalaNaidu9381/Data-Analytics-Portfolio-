# ------------------- INSTALL -------------------
import os
import pandas as pd
import numpy as np
import faiss
import json
import time
from sentence_transformers import SentenceTransformer
import google.generativeai as genai

# ------------------- SETUP -------------------
os.environ["GOOGLE_API_KEY"] = ""  # put your key

genai.configure(api_key=os.environ["GOOGLE_API_KEY"])
llm = genai.GenerativeModel("gemini-2.5-flash")

# ------------------- LOAD DATA -------------------
df = pd.read_csv("/content/drive/MyDrive/netflix_titles.csv")

movies = df[df["type"] == "Movie"].dropna(subset=["description"])

texts = movies["description"].tolist()
titles = movies["title"].tolist()
years = movies["release_year"].tolist()

# ------------------- EMBEDDINGS -------------------
embed_model = SentenceTransformer("all-MiniLM-L6-v2")
embeddings = embed_model.encode(texts)

# ------------------- FAISS -------------------
dim = embeddings.shape[1]
index = faiss.IndexFlatL2(dim)
index.add(np.array(embeddings))

# ------------------- MEMORY -------------------
memory = []

def add_to_memory(user, response):
    memory.append({"user": user, "response": response})

def get_memory():
    return memory[-5:]  # last 5 interactions


# ------------------- TOOLS -------------------

def search_movies(query, k=5):
    q_emb = embed_model.encode([query])
    D, I = index.search(np.array(q_emb), k)

    results = []
    for idx in I[0]:
        results.append({
            "title": titles[idx],
            "year": years[idx],
            "description": texts[idx]
        })

    return results


def summarize_movies(results):
    combined = "\n".join([r["description"] for r in results[:3]])

    response = llm.generate_content(f"""
    Summarize these movie descriptions:

    {combined}
    """)

    return response.text


def recommend_movies(results):
    combined = "\n".join([r["description"] for r in results[:3]])

    response = llm.generate_content(f"""
    Based on these movies, recommend similar movies.
    Give only movie names.

    {combined}
    """)

    return response.text


# ------------------- AGENT -------------------

def agent(query):
    print("\nUser:", query)

    q = query.lower()

    # 🔥 STEP 1: Decide (NO LLM)
    if "summarize" in q and "recommend" in q:
        mode = "MULTI"
    elif "summarize" in q:
        mode = "SUMMARIZE"
    elif "recommend" in q:
        mode = "RECOMMEND"
    elif "what is" in q or "who is" in q:
        mode = "DIRECT"
    else:
        mode = "SEARCH"

    # 🔥 STEP 2: Use Memory (context)
    past = get_memory()

    # 🔥 STEP 3: Search (RAG)
    results = search_movies(query)

    # 🔥 STEP 4: Tool Execution
    if mode == "SEARCH":
        answer = "\n".join([f"{r['title']} ({r['year']})" for r in results])

    elif mode == "SUMMARIZE":
        answer = summarize_movies(results)

    elif mode == "RECOMMEND":
        answer = recommend_movies(results)

    elif mode == "MULTI":
        summary = summarize_movies(results)
        recs = recommend_movies(results)

        answer = f"""
Summary:
{summary}

Recommendations:
{recs}
"""

    elif mode == "DIRECT":
        response = llm.generate_content(query)
        answer = response.text

    else:
        answer = "I couldn't understand your request."

    # 🔥 STEP 5: Save Memory
    add_to_memory(query, answer)

    return answer


# ------------------- RUN LOOP -------------------

while True:
    user_input = input("\nAsk: ")

    if user_input.lower() == "exit":
        break

    print(agent(user_input))
